{
  "expo": {
    "name": "Assignment Planner",
    "slug": "assignment-planner",
    "version": "1.0.0",
    "scheme": "assignmentplanner",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elliedunlevy.assignmentplanner",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCalendarsFullAccessUsageDescription": "Assignment Planner adds your assignment due dates to a dedicated calendar it creates, so you can see them alongside your other events. It never reads the events on your other calendars.",
        "NSCalendarsUsageDescription": "Assignment Planner adds your assignment due dates to a dedicated calendar it creates, so you can see them alongside your other events. It never reads the events on your other calendars."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3B5BDB"
      },
      "package": "com.elliedunlevy.assignmentplanner",
      "permissions": ["READ_CALENDAR", "WRITE_CALENDAR", "SCHEDULE_EXACT_ALARM", "USE_EXACT_ALARM"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b8c50bf2-db4c-49b1-bbc5-9f8371903240"
      }
    },
    "owner": "edunlevy",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      "expo-calendar",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.603041259915-podoirniape9mshtee0jnvtmelkq9p4k"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              { "name": "GoogleUtilities", "modular_headers": true },
              { "name": "RecaptchaInterop", "modular_headers": true }
            ]
          }
        }
      ]
    ]
  }
}
